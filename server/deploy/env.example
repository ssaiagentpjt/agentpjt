# 홈서버에서 이 파일을 server/deploy/.env 로 복사해 값을 채운다. .env 는 커밋하지 않는다(server/.gitignore).

# 앱이 X-API-Key 헤더로 보내는 키. 무작위 문자열로 만든다. 예: openssl rand -hex 24
SHOP_API_KEY=

# Cloudflare Zero Trust > Networks > Tunnels 에서 만든 터널의 토큰
CLOUDFLARE_TUNNEL_TOKEN=

# 이미지 URL 앞에 붙는 공개 주소. 바꿀 일이 없으면 비워 둔다(기본 https://shop-api.bomun.dev)
SHOP_PUBLIC_BASE_URL=
